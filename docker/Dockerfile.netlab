# Isolated test network for the "file upload under link failure" experiment.
#
# The experiment builds its own network namespaces, virtual links (veth pairs) and routes
# *inside* this container, so the host's network configuration is never touched. It needs
# NET_ADMIN and SYS_ADMIN (to create namespaces) and is started by netlab/runner.py with:
#
#   docker run --rm --cap-add NET_ADMIN --cap-add SYS_ADMIN --security-opt apparmor=unconfined \
#       -v <project>:/work routeresq-netlab:1 python -m netlab.lab ...
#
# Build once:  docker build -f docker/Dockerfile.netlab -t routeresq-netlab:1 docker
FROM python:3.12-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
